# Harbour configuration. Copy to `.env` (never commit `.env`) and fill in the values.
# Generate secrets with:  openssl rand -base64 48   (AUTH_SECRET, CRON_SECRET)
#                         openssl rand -base64 32   (ENCRYPTION_KEY: must decode to 32 bytes)

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://budget:budget@localhost:5432/budget?schema=public"
# Signs session tokens and other secrets. At least 32 characters.
AUTH_SECRET=""
# AES-256-GCM key (base64 of 32 random bytes) for provider access tokens stored in the database.
ENCRYPTION_KEY=""
# Public URL of the app (used in emails, redirects and same-origin checks).
APP_URL="http://localhost:3000"

# ── Environment ─────────────────────────────────────────────────────────────
# Overrides NODE_ENV for app behaviour (development | test | production).
# APP_ENV="development"

# ── Bank data provider ──────────────────────────────────────────────────────
# mock (simulated bank, default outside production) | plaid | flinks
BANKING_PROVIDER="mock"

# Plaid (https://plaid.com). Note: Plaid does not cover Neo Financial.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
# Leave unset: Harbour syncs on a schedule and on demand, and has no Plaid webhook endpoint yet.
# PLAID_WEBHOOK_URL=""

# Flinks (https://flinks.com, Canadian coverage incl. Neo Financial; business contract required).
FLINKS_CUSTOMER_ID=""
# Base URL of your Flinks instance, e.g. https://<instance>-api.private.fin.ag
# (the adapter adds /v3/<FLINKS_CUSTOMER_ID>/BankingServices itself).
FLINKS_API_URL=""
# e.g. https://<instance>-iframe.private.fin.ag/v2/
FLINKS_CONNECT_URL=""
# Server-side secret used to mint short-lived authorize tokens.
FLINKS_SECRET=""
# Data API key (x-api-key), if your Flinks instance requires one.
FLINKS_API_KEY=""

# ── Email ───────────────────────────────────────────────────────────────────
# console (prints emails to the server log) | resend
EMAIL_PROVIDER="console"
EMAIL_FROM="Harbour <no-reply@example.com>"
RESEND_API_KEY=""

# ── AI (optional, off by default) ───────────────────────────────────────────
# Used only when ENABLE_AI_CATEGORIZATION or ENABLE_AI_ASSISTANT is on.
ANTHROPIC_API_KEY=""

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Bearer token for GET /api/cron/daily (Vercel Cron sends it automatically when set).
CRON_SECRET=""

# ── Feature flags (true/false; defaults in lib/flags) ───────────────────────
# Demo mode is on by default outside production: "Try the demo" signs into a shared
# demo account filled with simulated data.
DEMO_MODE="true"
ENABLE_BANKING="true"
ENABLE_CSV_IMPORT="true"
ENABLE_AUTOMATIONS="true"
ENABLE_NOTIFICATIONS="true"
ENABLE_AI_CATEGORIZATION="false"
ENABLE_AI_ASSISTANT="false"
ENABLE_MULTI_CURRENCY="false"

# Set by the Mac desktop app build/runtime (see docs/DESKTOP.md). Leave unset for the web app.
# HARBOUR_DESKTOP="false"
